---
import Base from '../layouts/Base.astro'; import seed from '../../02-items.seed.json'; import copy from '../../26-site-copy.seed.json'; import taxonomy from '../../07-category-taxonomy.json';
const launch = seed.items.filter(x=>x.launch_candidate&&x.index_state==='indexable'); const groups=taxonomy.categories.filter(c=>launch.some(i=>i.category_slug===c.slug)).map(c=>({ ...c, items:launch.filter(i=>i.category_slug===c.slug)}));
const icon=(slug)=>slug.includes('filter')?'필터':slug.includes('car')||slug.includes('wiper')?'차량':slug==='mattress'?'생활':'교체';
---
<Base title="교체뚝딱 | 이거, 언제 바꿔야 하지?" description={copy.home.sub}><section class="hero hero-home"><div><p class="eyebrow">{copy.home.eyebrow}</p><h1>{copy.home.h1}</h1><p class="hero-copy">{copy.home.sub}</p><form class="search-bar" action="/search/"><label class="sr-only" for="home-q">품목 검색</label><input id="home-q" name="q" placeholder={copy.home.search_placeholder} /><button>교체 기준 찾기 <span aria-hidden="true">→</span></button></form><p class="helper">예: 칫솔 · 공기청정기 필터 · 와이퍼</p><p class="local-note">✓ 회원가입 없이 이 브라우저에만 저장합니다.</p></div><aside class="hero-panel"><span class="panel-kicker">오늘의 기준</span><strong>기간만 외우지 마세요.</strong><p>제품, 사용량, 상태를 함께 확인하는 생활관리 도구입니다.</p></aside></section><section class="trust-section"><div class="section-heading"><p class="eyebrow">TRUST NOTE</p><h2>{copy.home.trust_title}</h2><p>{copy.home.trust_body}</p></div><div class="principles"><article><span aria-hidden="true">01</span><h3>공식자료 우선</h3><p>제조사·정부·전문기관의 근거를 먼저 봅니다.</p></article><article><span aria-hidden="true">02</span><h3>제품별 차이 고려</h3><p>모델과 사용환경이 다르면 같은 답을 강요하지 않습니다.</p></article><article><span aria-hidden="true">03</span><h3>확인되지 않은 숫자 금지</h3><p>근거 없는 고정 교체주기를 만들지 않습니다.</p></article></div></section><section class="catalog"><div class="section-heading inline"><div><p class="eyebrow">LAUNCH ITEMS</p><h2>지금 확인할 수 있는 품목</h2></div><p>한 줄 답부터 내 상황 확인까지.</p></div>{groups.map(group=><section class="item-group"><h3>{group.label}</h3><div class="item-grid">{group.items.map(item=><a class="item-card" href={`/item/${item.slug}/`}><span class="item-icon">{icon(item.slug)}</span><strong>{item.name}</strong><span>{item.cycle_text}</span><b aria-hidden="true">→</b></a>)}</div></section>)}</section><section class="myhome-cta"><div><p class="eyebrow">MY HOME</p><h2>내 교체일 관리</h2><p>{copy.home.myhome_body}</p></div><a class="button button-light" href="/my-home/">내 관리 시작하기 <span aria-hidden="true">→</span></a></section></Base>
