---
import Base from '../../layouts/Base.astro'; import seed from '../../../02-items.seed.json'; import content from '../../../05-launch-content.seed.json'; import registry from '../../../04-source-registry.json';
export function getStaticPaths(){return content.items.map(item=>({params:{slug:item.slug}}));}
const {slug}=Astro.params,item=content.items.find(x=>x.slug===slug),seedItem=seed.items.find(x=>x.slug===slug),sources=item.source_ids.map(id=>({id,...registry.sources[id]}));
const related=['mattress','power-strip'].includes(slug)?[]:item.related_slugs.map(x=>content.items.find(y=>y.slug===x)).filter(Boolean); const model=item.tool_type.includes('model'),vehicle=item.tool_type.includes('vehicle'),usage=item.tool_type.includes('usage');
---
<Base title={item.title} description={item.meta_description}><nav class="crumb" aria-label="breadcrumb"><a href="/">홈</a> / {item.name}</nav><article data-item={slug} data-tool={item.tool_type}><p class="badge">{item.evidence_badge}</p><h1>{item.h1}</h1><section class="answer"><h2>{item.answer_card.headline}</h2><p>{item.answer_card.summary}</p></section><section class="tool"><h2>내 상황 확인</h2>{model||vehicle?<><p class="notice">{vehicle?'차종·연식과 차량 설명서를':'제품 모델명·부품코드를'} 먼저 확인하세요.</p><label>{vehicle?'차종/연식':'모델명'} <input data-model placeholder="이 브라우저에만 저장됩니다" /></label><button data-save-model>기억하기</button></>:null}{vehicle||usage?<><label>{vehicle?'현재 주행거리':'현재 사용횟수'} <input type="number" min="0" data-usage /></label><button data-save-usage>직접 입력값 저장</button></>:null}{item.tool_type==='calendar_condition'?<><label>마지막 교체일 <input type="date" data-exact-date /></label><label><input type="checkbox" data-approx /> 정확히 기억나지 않아요</label><button data-check-date>확인하기</button></>:null}{!model&&!vehicle&&!usage&&item.tool_type!=='calendar_condition'?<p class="notice">고정된 날짜보다 아래 상태를 먼저 확인하세요. 정확한 D-Day를 표시하지 않습니다.</p>:null}<p data-result aria-live="polite"></p><button data-replace>교체했어요</button>{seedItem.care_actions.includes('maintain')&&<button data-maintain>관리했어요</button>}<button data-save-home>내 관리에 저장</button><button data-ics>캘린더 파일 받기</button></section><div class="ad">광고 영역 (AdSense 설정 전 placeholder)</div><section><h2>교체 신호</h2><ul>{item.check_signs.map(x=><li>{x}</li>)}</ul><h2>함께 고려할 점</h2><ul>{item.adjustment_factors.map(x=><li>{x}</li>)}</ul><p>{item.replacement_reason}</p></section><section><h2>근거 출처</h2><ul>{sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.authority} — {s.name}</a><span class="source-level">{s.level==='A_DIRECT'?'A_DIRECT · 공식/직접 근거':'B_GENERAL · 보조 일반 근거'}</span></li>)}</ul>{slug==='shower-filter'&&<p class="notice">애터미의 기간 예시는 해당 필터 제품 예시이며, 모든 샤워기 필터의 공통 교체주기가 아닙니다. 필터 종류·제품·수질과 제조사 기준을 확인하세요.</p>}</section><section><h2>구매 전 확인</h2>{model||vehicle?<p>호환 가능한 모델·차종·부품번호를 확인하기 전에는 일반 상품을 추천하지 않습니다.</p>:<><p>제휴 상품은 실제 연동 전 placeholder입니다. 가격과 재고는 판매처에서 최종 확인하세요.</p><div class="affiliate">제휴 상품 영역 (Coupang 연동 전 placeholder)</div></>}</section>{item.beorim.status==='verified'&&<p><a class="beorim" href={item.beorim.url}>교체한 기존 제품은 어떻게 버릴까요?</a></p>}{related.length>0&&<section data-related-items><h2>함께 확인할 품목</h2><ul>{related.map(x=><li><a href={`/item/${x.slug}/`}>{x.name} 교체주기</a></li>)}</ul></section>}</article><script is:inline src="/app.js"></script></Base>
