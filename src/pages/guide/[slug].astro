---
import Base from '../../layouts/Base.astro';
import {guides, auditedSources} from '../../data/guides';
import content from '../../../05-launch-content.seed.json';
import registry from '../../../04-source-registry.json';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug}}));}
const guide=guides.find(x=>x.slug===Astro.params.slug);
const relatedGuides=[...new Set([...(guide.related_guides||[]),...guides.filter(g=>g.related_guides?.includes(guide.slug)).map(g=>g.slug)])].filter(slug=>slug!==guide.slug);
---
<Base title={`${guide.title} - 교체뚝딱`} description={guide.description}>
  <nav class="crumb" aria-label="breadcrumb"><a href="/">홈</a> / 실용 가이드</nav>
  <article><p class="badge">확인 순서 가이드</p><h1 style="word-break:keep-all;overflow-wrap:normal;text-wrap:balance">{guide.title}</h1><p>{guide.intro}</p>
    {guide.sections.map(section=><section><h2>{section.heading}</h2><p>{section.text}</p>{section.audit_source_ids?.map(id=><p class="helper"><a href={auditedSources[id].url} rel="noopener noreferrer">근거: {auditedSources[id].authority} — {auditedSources[id].name}</a></p>)}</section>)}
    <section><h2>내 품목에서 확인하기</h2><ul class="cards">{guide.items.map(slug=>{const item=content.items.find(x=>x.slug===slug);return <li><a href={`/item/${slug}/`}><strong>{item.name}</strong><span>{item.answer_card.headline}</span></a></li>;})}</ul></section>
    {guide.source_ids.length>0&&<section><h2>공식 근거와 적용 범위</h2><ul>{guide.source_ids.map(id=>{const source=registry.sources[id];return <li><a href={source.url} rel="noopener noreferrer">{source.authority} — {source.name}</a><p>{source.claims?.[0]?.scope || '세부 적용 대상은 원문과 연결된 상세에서 확인하세요.'}</p></li>;})}</ul></section>}
    {guide.audit_source_ids?.length>0&&<section><h2>이 질문에 사용한 공식 자료</h2><ul>{guide.audit_source_ids.map(id=>{const source=auditedSources[id];return <li><a href={source.url} rel="noopener noreferrer">{source.authority} — {source.name}</a><p>{source.scope}</p><p class="helper">{source.level} · 원문 확인 {source.checked_at}</p></li>;})}</ul></section>}
    {relatedGuides.length>0&&<section><h2>이어서 확인할 질문</h2><ul>{relatedGuides.map(slug=><li><a href={`/guide/${slug}/`}>{guides.find(x=>x.slug===slug).title}</a></li>)}</ul></section>}
  </article>
</Base>
