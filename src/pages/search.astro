---
import Base from '../layouts/Base.astro'; import seed from '../../02-items.seed.json'; import copy from '../../26-site-copy.seed.json';
const index = seed.items.map(({ slug, name, aliases, seo, verification_status }) => ({ slug, name, aliases, keywords: [seo.primary_keyword, ...seo.secondary_keywords], verification_status }));
---
<Base title="품목 검색 | 교체뚝딱" noindex><h1>교체 품목 검색</h1><form id="search-form"><label for="q">품목명</label><input id="q" name="q" autocomplete="off" /><button>검색</button></form><p id="search-status" aria-live="polite"></p><ul id="search-results"></ul><script define:vars={{ index, copy }}>const norm=s=>s.normalize('NFC').trim().toLowerCase().replace(/\s+/g,' ');const q=new URLSearchParams(location.search).get('q')||'',input=document.querySelector('#q'),status=document.querySelector('#search-status'),results=document.querySelector('#search-results');input.value=q;function show(items){results.innerHTML='';items.forEach(x=>{const li=document.createElement('li');li.innerHTML=x.verification_status==='verified'?`<a href="/item/${x.slug}/">${x.name}</a>`:`${x.name} — 확인 중`;results.append(li)})}function run(raw){const term=norm(raw);if(!term||/[<>]/.test(raw)){status.textContent='검색어를 입력해 주세요.';results.innerHTML='';return}if(term==='에어컨필터'){status.textContent='어느 에어컨 필터를 찾으세요?';show(index.filter(x=>['air-conditioner-filter','cabin-air-filter'].includes(x.slug)));return}const found=index.filter(x=>[x.name,...x.aliases,...x.keywords].some(v=>norm(v).includes(term)||term.includes(norm(v))));if(!found.length){status.textContent=copy.missing.body;results.innerHTML='';return}status.textContent=found[0].verification_status==='needs_research'?copy.needs_research.body:(found.length===1?'검색 결과입니다.':`${found.length}개 품목을 찾았어요.`);show(found)}document.querySelector('#search-form').addEventListener('submit',e=>{e.preventDefault();history.replaceState({},'',`?q=${encodeURIComponent(input.value)}`);run(input.value);});run(q);</script></Base>
