---
const { title = '교체뚝딱', description = '근거를 확인한 생활용품 교체 안내', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://gyochettukttak.com').href;
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': Astro.url.pathname === '/' ? 'WebSite' : 'WebPage', name: title, description, url: canonical, publisher: { '@type': 'Organization', name: '교체뚝딱' } });
const path = Astro.url.pathname;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />{noindex && <meta name="robots" content="noindex,follow" />}<meta property="og:title" content={title} /><meta property="og:description" content={description} /><script type="application/ld+json" set:html={jsonLd}></script><link rel="stylesheet" href="/styles.css" /></head><body><header class="site-header"><div class="header-inner"><a class="wordmark" href="/" aria-label="교체뚝딱 홈"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3a13 13 0 1 0 13 13H16z"/><path d="M16 3v13h13"/></svg><span>교체<span>뚝딱</span></span></a><nav aria-label="주요 메뉴"><a class={path.startsWith('/search')?'current':''} href="/search/">검색</a><a class={path.startsWith('/my-home')?'current':''} href="/my-home/">내 관리</a><a class={path.startsWith('/source-policy')?'current':''} href="/source-policy/">출처 원칙</a></nav></div></header><main><slot /></main><footer class="site-footer"><div><strong>교체뚝딱</strong><p>근거를 확인한 생활용품 교체 안내</p></div><nav aria-label="푸터 메뉴"><a href="/about/">소개</a><a href="/source-policy/">출처 원칙</a><a href="/privacy/">개인정보</a><a href="/affiliate-disclosure/">제휴 고지</a></nav></footer></body></html>
